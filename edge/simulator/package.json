{
  "name": "sf-sensor-simulator",
  "version": "1.0.0",
  "description": "Smart Factory sensor simulator — publishes realistic MQTT telemetry for 8 industrial devices",
  "main": "index.js",
  "scripts": {
    "start": "ts-node index.ts",
    "dev": "ts-node-dev --respawn --transpile-only index.ts",
    "build": "tsc",
    "run:built": "node dist/index.js"
  },
  "dependencies": {
    "mqtt": "^5.3.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.8",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
